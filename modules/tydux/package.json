{
    "name": "@w11k/tydux",
    "version": "18.0.0",
    "author": "W11K GmbH",
    "contributors": [
        "Roman Roelofsen",
        "Philipp Burgmer",
        "Sascha Engmann",
        "Mario Sallat"
    ],
    "license": "Apache-2.0",
    "homepage": "https://github.com/w11k/Tydux",
    "repository": {
        "type": "git",
        "url": "https://github.com/w11k/Tydux.git"
    },
    "files": [
        "dist"
    ],
    "typings": "./dist/bundle/index.d.ts",
    "main": "./dist/bundle/index.js",
    "module": "./dist/esm2015/index.js",
    "esm2015": "./dist/esm2015/index.js",
    "scripts": {
        "build": "npm run clean && npm test && npm run compile && npm run build:copy_from_root",
        "build:copy_from_root": "shx cp ../../README.md ../../LICENSE .",
        "clean": "shx rm -rf dist",
        "compile": "npm run compile:base && npm run compile:esm2015",
        "compile:base": "tsc -p tsconfig.json",
        "compile:esm2015": "tsc -p tsconfig.dist.esm2015.json",
        "lint": "eslint src",
        "prepublishOnly": "npm run build",
        "test": "jest --config ./jest.config.js",
        "test:watch": "jest --config ./jest.config.js --watchAll"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@w11k/rx-ninja": "^6.0.1"
    },
    "peerDependencies": {
        "@redux-devtools/extension": "^3.3.0 || ^4.0.0",
        "immer": "^9.0.0 || ^10.0.0 || ^11.0.0",
        "redux": "^4.2.1 || ^5.0.0",
        "rxjs": "^6.2.0 || ^7.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@redux-devtools/extension": "^4.0.0",
        "@types/jest": "^29.5.12",
        "eslint": "^9.39.4",
        "immer": "^11.0.0",
        "jest": "^29.7.0",
        "jest-environment-jsdom": "^29.7.0",
        "redux": "^5.0.1",
        "rxjs": ">= 6.2.0",
        "shx": "^0.3.3",
        "ts-jest": "^29.4.12",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.68.0"
    }
}
