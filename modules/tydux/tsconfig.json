{
    "compileOnSave": false,
    "compilerOptions": {
        "outDir": "dist/bundle",
        "rootDir": "src",
        "target": "es2018",
        "module": "node16",
        "moduleResolution": "node16",
        "strict": true,
        "declaration": true,
        "sourceMap": true,
        "skipLibCheck": true,
        "types": [],
        "lib": [
            "dom",
            "ES2018"
        ]
    },
    "include": [
        "src"
    ],
    "exclude": [
        "**/*.test.ts",
        "src/testing/test-utils-internal.ts"
    ]
}
